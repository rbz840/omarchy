# --- GPU / video accel (Broadcom VideoCore VI) ---
mesa
vulkan-broadcom
vulkan-icd-loader
vulkan-tools
libglvnd
mpv
# Stock ALARM 'ffmpeg' (9.x, sonames libavcodec.so=63...). NOT ffmpeg-rpi:
# that package (7.1.5) is for RPi 3/4/400 (MMAL-era), provides ffmpeg-7.1
# sonames, conflicts nothing of 'ffmpeg', and NOTHING in ALARM links it
# (verified 2026-09-06: 0/13295 ALARM packages depend on it). Installing both
# would pull two parallel ffmpeg stacks. The Pi 5 HEVC path is
# kernel linux-rpi (rpivid) + mpv --hwdec=drm (GPU compositing of
# software-decoded frames) or an ffmpeg built with --enable-v4l2-request
# (mainlined in FFmpeg 8.0; stock ALARM 9.0.1 does NOT enable it — see
# tests/validate-pi-hardware.sh for the on-Pi hwdec probe).
ffmpeg
gst-plugin-pipewire
gst-plugins-base
ffmpegthumbnailer

